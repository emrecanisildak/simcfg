      "phase_2_red_push": {
        "trigger": {
          "at": "15 min"
        },
        "actions": [
          {
            "action": "core.action.set_variable",
            "params": {
              "name": "phase",
              "value": 2
            }
          },
          {
            "action": "core.action.log",
            "params": {
              "message": "Phase 2: red push",
              "level": "alert"
            }
          },
          {
            "action": "core.action.set_kinematics",
            "on": "bandit_1",
            "params": {
              "speed": "520 kts"
            }
          },
          {
            "action": "core.action.set_radar_mode",
            "on": "bandit_1",
            "params": {
              "system": "radar",
              "mode": "search"
            }
          },
          {
            "action": "core.action.set_master_arm",
            "on": "bandit_1",
            "params": {
              "launcher": "weapons",
              "armed": true
            }
          }
        ]
      },
      "civil_in_mez_alert": {
        "trigger": {
          "event": "core.event.platform.area_entered",
          "filter": {
            "all": [
              {
                "op": "eq",
                "args": [
                  {
                    "var": "event.area"
                  },
                  "red_mez"
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "var": "event.entity"
                  },
                  "airliner_1"
                ]
              }
            ]
          }
        },
        "actions": [
          {
            "action": "core.action.log",
            "params": {
              "message": "Civil traffic inside red MEZ",
              "level": "warning"
            }
          }
        ]
      },
      "red_emcon_until_phase2": {
        "trigger": {
          "every": "30 s"
        },
        "condition": {
          "all": [
            {
              "op": "eq",
              "args": [
                {
                  "var": "bb.phase"
                },
                1
              ]
            },
            {
              "op": "eq",
              "args": [
                {
                  "var": "entities.bandit_1.systems.radar.state.mode"
                },
                "search"
              ]
            }
          ]
        },
        "actions": [
          {
            "action": "core.action.set_radar_mode",
            "on": "bandit_1",
            "params": {
              "system": "radar",
              "mode": "standby"
            }
          }
        ]
      }
