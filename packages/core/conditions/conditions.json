      "name": {
        "tr": "Olasılık",
        "en": "Random chance"
      },
      "description": "Senaryo tohumuna (seed) bağlı deterministik rastgelelik."
    },
    "spec": {
      "category": "logic",
      "parameters": {
        "probability": {
          "type": "number",
