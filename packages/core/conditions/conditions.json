  {
    "apiVersion": "simcfg/v1",
    "kind": "ConditionType",
    "id": "core.cond.fuel_below",
    "version": "1.0.0",
    "meta": {
      "name": {
        "tr": "Yakıt eşik altında",
        "en": "Fuel below"
      },
      "description": "Veriyle tanımlı (expression) koşul örneği."
    },
    "spec": {
      "category": "platform",
      "requires": {
        "platformType": "core.platformtype.fixed_wing"
      },
      "parameters": {
        "fraction": {
          "type": "number",
          "required": true,
          "min": 0,
          "max": 1
        }
      },
      "implementation": {
        "type": "expression",
        "body": {
          "op": "lt",
          "args": [
            {
              "var": "self.fuel"
            },
            {
              "op": "mul",
              "args": [
                {
                  "param": "fraction"
                },
                {
                  "var": "self.params.fuelCapacity"
                }
              ]
            }
          ]
        }
      }
    }
  },
  {
