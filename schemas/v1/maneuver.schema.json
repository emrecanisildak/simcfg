{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simcfg.dev/schemas/v1/maneuver.schema.json",
  "title": "Maneuver - veriyle tanımlı manevra (segment dizisi)",
  "allOf": [{ "$ref": "document.schema.json" }],
  "$defs": {
    "segment": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["turn", "climb", "descend", "accelerate", "hold", "roll", "pull", "heading"] },
        "g": true, "headingChange": true, "heading": true, "relative": true, "direction": true,
        "altitudeChange": true, "rate": true, "speed": true, "duration": true, "angle": true,
        "until": { "$ref": "common.schema.json#/$defs/expression" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    }
  },
  "properties": {
    "kind": { "const": "Maneuver" },
    "spec": {
      "type": "object",
      "properties": {
        "domain": { "type": "string" },
        "parameters": { "$ref": "common.schema.json#/$defs/descriptorMap" },
        "segments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/segment" } },
        "ui": { "$ref": "common.schema.json#/$defs/uiHints" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    }
  }
}
